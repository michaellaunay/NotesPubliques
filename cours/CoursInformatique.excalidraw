		{
			"id": "drF2H6F1",
			"type": "text",
			"x": 2365,
			"y": 3325,
			"width": 571.58349609375,
			"height": 157.5,
			"angle": 0,
			"strokeColor": "#115e59",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": "ci-frame-6f0a53fb760e",
			"roundness": null,
			"seed": 62340986,
